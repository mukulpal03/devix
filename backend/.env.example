# Server Configuration
PORT=your_port
REACT_PROJECT_COMMAND=your_react_scaffold_command

# Database
DATABASE_URL=your_postgresql_connection_string

# Docker
DOCKER_IMAGE_NAME=your_sandbox_image_name

# Storage (LOCAL or S3)
STORAGE_TYPE=your_storage_type
S3_BUCKET=your_s3_bucket_name
S3_REGION=your_s3_region
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_FORCE_PATH_STYLE=your_s3_path_style_boolean
